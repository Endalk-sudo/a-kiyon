rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Photo uploads — client SDK used via /api/upload.
    // Read is public because production serves non-expiring signed URLs
    // (getSignedUrl) which bypass rules; the UUID path is unguessable.
    match /uploads/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.size < 5 * 1024 * 1024   // max 5MB
        && request.resource.contentType.matches('image/.*');
    }
    // Everything else — block direct client access
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
