rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Photo uploads — all writes go through /api/upload (admin SDK, bypasses
    // rules), so direct client writes are denied entirely.
    // Read is public because production serves non-expiring signed URLs
    // (getSignedUrl) which bypass rules; the UUID path is unguessable.
    match /uploads/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }
    // Everything else — block direct client access
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
