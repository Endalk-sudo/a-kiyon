# Firebase Admin SDK (server-side)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Firebase Client SDK (browser-side)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Emulators (set to "true" for local development)
FIREBASE_EMULATOR=false
NEXT_PUBLIC_FIREBASE_EMULATOR=false

# Backblaze B2 (production photo storage — 10 GB free, ~$6/TB/mo after).
# Required whenever FIREBASE_EMULATOR is not "true" (upload/storage routes
# return 500 "Storage not configured" without them). Create an application
# key restricted to the bucket, and enable a Lifecycle Rule "Keep only the
# last version" so purged photos actually free storage (buckets are always
# versioned).
B2_BUCKET=
B2_REGION=
B2_APPLICATION_KEY_ID=
B2_APPLICATION_KEY=
# Optional: S3 endpoint + public URL overrides (defaults derive from B2_REGION).
# B2_S3_ENDPOINT=https://s3.<region>.backblazeb2.com
# B2_PUBLIC_URL=https://s3.<region>.backblazeb2.com/<bucket>

