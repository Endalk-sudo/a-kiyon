# Firebase Admin SDK (server-side)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Firebase Client SDK (browser-side)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Emulators (set to "true" for local development; auth + firestore only —
# photo storage is always Backblaze B2)
FIREBASE_EMULATOR=false
NEXT_PUBLIC_FIREBASE_EMULATOR=false

# Backblaze B2 (the ONLY photo storage backend — also required for local
# uploads). 10 GB free, ~$6/TB/mo after. The bucket stays PRIVATE: the app
# stores canonical paths on member docs and serves short-lived presigned
# URLs (no public-read toggle needed). Create an application key restricted
# to the bucket with read/write/list/delete. Optional: enable the Lifecycle
# Rule "Keep only the last version" so purged photos actually free storage
# (buckets are always versioned).
B2_BUCKET=
# Accepts the bare region ("us-east-005") OR the full S3 endpoint URL shown
# in the B2 console ("https://s3.us-east-005.backblazeb2.com").
B2_REGION=
B2_APPLICATION_KEY_ID=
B2_APPLICATION_KEY=
# Optional: S3 endpoint override (defaults to https://s3.<region>.backblazeb2.com).
# B2_S3_ENDPOINT=https://s3.<region>.backblazeb2.com

